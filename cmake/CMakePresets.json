{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "minimal",
      "hidden": false,
      "description": "local kein's configuration preset",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -std=c++20",
        "CMAKE_C_FLAGS": "-Wall -Wextra -Wpedantic",
        "LAMMPS_SIZES": "bigbig",
        "LAMMPS_MACHINE": "mpi",
        "BUILD_SHARED_LIBS": "yes",
        "CMAKE_DISABLE_FIND_PACKAGE_nvpl": "ON",
        "BUILD_LIB": "yes",
        "BUILD_MPI": "yes",
        "BUILD_TOOLS": "yes",
        "BUILD_LAMMPS_SHELL": "no",
        "BUILD_LAMMPS_GUI": "no",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "environment": {},
      "generator": "Unix Makefiles",
      "binaryDir": "../build"
    },
    {
      "name": "full",
      "hidden": false,
      "description": "local kein's configuration preset",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_FLAGS": "-Ofast -std=c++20",
        "CMAKE_C_FLAGS": "-Ofast",
        "CMAKE_INSTALL_PREFIX": "$env{VIRTUAL_ENV}",
        "LAMMPS_SIZES": "bigbig",
        "LAMMPS_MACHINE": "mpi",
        "BUILD_SHARED_LIBS": "yes",
        "CMAKE_DISABLE_FIND_PACKAGE_nvpl": "ON",
        "BUILD_LIB": "yes",
        "BUILD_MPI": "yes",
        "BUILD_TOOLS": "yes",
        "BUILD_LAMMPS_SHELL": "no",
        "BUILD_LAMMPS_GUI": "no",
        "PKG_ADIOS": "yes",
        "ADIOS2_DIR": "$env{REPOS}/ADIOS2/build",
        "PKG_PYTHON": "yes",
        "Python_EXECUTABLE": "$env{VIRTUAL_ENV}/bin/python3",
        "PKG_COMPRESS": "yes",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "environment": {},
      "generator": "Unix Makefiles",
      "binaryDir": "../build"
    },
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset preset",
      "cacheVariables": {
        "CMAKE_DISABLE_FIND_PACKAGE_nvpl": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_C_STANDARD": "17",
        "LAMMPS_SIZES": "bigbig",
        "LAMMPS_MACHINE": "mpi",
        "BUILD_MPI": "yes",
        "BUILD_SHARED_LIBS": "yes",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_CXX_FLAGS_DEBUG": "-Wall -Wextra -Wpedantic -Og -g",
        "CMAKE_C_FLAGS_DEBUG": "-Wall -Wextra -Wpedantic -Og -g",
        "CMAKE_Fortran_FLAGS_DEBUG": "-Wall -Wextra -Wpedantic -Og -g -std=f2003",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-Wall -Wextra -g -O2 -DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-Wall -Wextra -g -O2 -DNDEBUG",
        "CMAKE_Fortran_FLAGS_RELWITHDEBINFO": "-Wall -Wextra -g -O2 -DNDEBUG -std=f2003",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_Fortran_FLAGS_RELEASE": "-O3 -DNDEBUG -std=f2003"
      },
      "environment": {},
      "generator": "Unix Makefiles",
      "binaryDir": "../build"
    },
    {
      "name": "nix",
      "hidden": true,
      "description": "Nix base preset preset",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_Fortran_COMPILER": "gfortran",
        "CMAKE_AR": "$env{GCC_AR_PATH}",
        "CMAKE_RANLIB": "$env{GCC_RANLIB_PATH}"
      }
    },
    {
      "name": "nixDebug",
      "hidden": false,
      "description": "Nix minimal preset",
      "inherits": "nix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_LIB": "no",
        "BUILD_TOOLS": "no",
        "BUILD_LAMMPS_SHELL": "no",
        "BUILD_LAMMPS_GUI": "no",
        "PKG_ADIOS": "no",
        "PKG_PYTHON": "no",
        "PKG_COMPRESS": "no"
      }
    },
    {
      "name": "nixRelWithDebInfo",
      "hidden": false,
      "inherits": "nix",
      "description": "Nix RelWithDebInfo preset",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_LIB": "yes",
        "BUILD_TOOLS": "yes",
        "BUILD_LAMMPS_SHELL": "no",
        "BUILD_LAMMPS_GUI": "no",
        "PKG_ADIOS": "yes",
        "PKG_PYTHON": "yes",
        "PKG_COMPRESS": "yes"
      }
    },
    {
      "name": "nixRelease",
      "hidden": false,
      "inherits": "nix",
      "description": "Nix Release preset",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_LIB": "yes",
        "BUILD_TOOLS": "yes",
        "BUILD_LAMMPS_SHELL": "no",
        "BUILD_LAMMPS_GUI": "no",
        "PKG_ADIOS": "yes",
        "PKG_PYTHON": "yes",
        "PKG_COMPRESS": "yes"
      }
    },
    {
      "name": "nixFast",
      "hidden": false,
      "inherits": "nix",
      "description": "Nix Release preset",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_LIB": "yes",
        "BUILD_TOOLS": "yes",
        "BUILD_LAMMPS_SHELL": "no",
        "BUILD_LAMMPS_GUI": "no",
        "PKG_ADIOS": "yes",
        "PKG_PYTHON": "yes",
        "PKG_COMPRESS": "yes",
        "CMAKE_CXX_FLAGS": "-ffast-math -fallow-store-data-races -fno-semantic-interposition -march=native -flto",
        "CMAKE_C_FLAGS": "-ffast-math -fallow-store-data-races -fno-semantic-interposition -march=native -flto",
        "CMAKE_Fortran_FLAGS": "-ffast-math -fallow-store-data-races -fno-semantic-interposition -march=native -flto -fstack-arrays -fno-protect-parens -Wno-unused-command-line-argument"
      }
    },
    {
      "name": "cluster",
      "hidden": false,
      "description": "local kein's configuration preset",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_FLAGS": "-Ofast -std=c++20",
        "CMAKE_C_FLAGS": "-Ofast",
        "CMAKE_INSTALL_PREFIX": "$env{VIRTUAL_ENV}",
        "LAMMPS_SIZES": "bigbig",
        "LAMMPS_MACHINE": "mpi",
        "BUILD_SHARED_LIBS": "yes",
        "CMAKE_DISABLE_FIND_PACKAGE_nvpl": "ON",
        "BUILD_LIB": "yes",
        "BUILD_MPI": "yes",
        "BUILD_TOOLS": "yes",
        "BUILD_LAMMPS_SHELL": "no",
        "BUILD_LAMMPS_GUI": "no",
        "PKG_ADIOS": "yes",
        "ADIOS2_DIR": "$env{REPOS_DIR}/ADIOS2/build",
        "PKG_PYTHON": "yes",
        "Python_EXECUTABLE": "$env{VIRTUAL_ENV}/bin/python3",
        "PKG_COMPRESS": "yes",
        "MPI_ROOT": "$env{MPI_HOME}"
      },
      "environment": {},
      "generator": "Unix Makefiles",
      "binaryDir": "../build"
    }
  ],
  "buildPresets": [
    {
      "name": "minimal",
      "description": "local kein's build preset",
      "configurePreset": "minimal",
      "cleanFirst": true,
      "targets": [
        "all"
      ],
      "inheritConfigureEnvironment": true,
      "jobs": 8
    },
    {
      "name": "full",
      "description": "local kein's build preset",
      "configurePreset": "full",
      "cleanFirst": true,
      "targets": [
        "all"
      ],
      "inheritConfigureEnvironment": true,
      "jobs": 8
    },
    {
      "name": "nixDebug",
      "description": "local kein's build preset",
      "configurePreset": "nixDebug",
      "cleanFirst": true,
      "targets": [
        "all"
      ],
      "inheritConfigureEnvironment": true,
      "jobs": 8
    },
    {
      "name": "nixRelWithDebInfo",
      "description": "local kein's build preset",
      "configurePreset": "nixRelWithDebInfo",
      "cleanFirst": true,
      "targets": [
        "all"
      ],
      "inheritConfigureEnvironment": true,
      "jobs": 8
    },
    {
      "name": "nixRelease",
      "description": "local kein's build preset",
      "configurePreset": "nixRelease",
      "cleanFirst": true,
      "targets": [
        "all"
      ],
      "inheritConfigureEnvironment": true,
      "jobs": 8
    },
    {
      "name": "nixFast",
      "configurePreset": "nixFast",
      "inherits": "nixRelease"
    },
    {
      "name": "cluster",
      "description": "local kein's build preset",
      "configurePreset": "cluster",
      "cleanFirst": true,
      "targets": [
        "all"
      ],
      "inheritConfigureEnvironment": true,
      "jobs": 16
    }
  ],
  "workflowPresets": [
    {
      "name": "minimal",
      "steps": [
        {
          "type": "configure",
          "name": "minimal"
        },
        {
          "type": "build",
          "name": "minimal"
        }
      ]
    },
    {
      "name": "full",
      "steps": [
        {
          "type": "configure",
          "name": "full"
        },
        {
          "type": "build",
          "name": "full"
        }
      ]
    },
    {
      "name": "nixDebug",
      "steps": [
        {
          "type": "configure",
          "name": "nixDebug"
        },
        {
          "type": "build",
          "name": "nixDebug"
        }
      ]
    },
    {
      "name": "nixRelWithDebInfo",
      "steps": [
        {
          "type": "configure",
          "name": "nixRelWithDebInfo"
        },
        {
          "type": "build",
          "name": "nixRelWithDebInfo"
        }
      ]
    },
    {
      "name": "nixRelease",
      "steps": [
        {
          "type": "configure",
          "name": "nixRelease"
        },
        {
          "type": "build",
          "name": "nixRelease"
        }
      ]
    },
    {
      "name": "nixFast",
      "steps": [
        {
          "type": "configure",
          "name": "nixFast"
        },
        {
          "type": "build",
          "name": "nixFast"
        }
      ]
    },
    {
      "name": "cluster",
      "steps": [
        {
          "type": "configure",
          "name": "cluster"
        },
        {
          "type": "build",
          "name": "cluster"
        }
      ]
    }
  ]
}
